# ===========================================================================
# Claude Phone — Kamailio Self-Hosted Configuration
# ===========================================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# Then start the stack:
#   docker compose up -d
#   ./kamailio/init-db.sh alice secretpass   # add softphone users
#   cd claude-api-server && node server.js   # start Claude bridge (native)
# ===========================================================================

# ---------------------------------------------------------------------------
# Network — CRITICAL for RTP audio
# ---------------------------------------------------------------------------
# Your server's LAN IP.  This goes into SDP packets so phones know where to
# send audio.  Use `ip addr` or `ifconfig` to find it.
EXTERNAL_IP=192.168.1.100

# SIP domain served by Kamailio.  Can be an IP or a local hostname.
# Softphones should use this as their SIP server / domain.
SIP_DOMAIN=pbx.local

# Digest auth realm (usually the same as SIP_DOMAIN)
KAM_REALM=pbx.local

# ---------------------------------------------------------------------------
# drachtio — SIP application server
# Runs on :5070 (Kamailio owns :5060)
# ---------------------------------------------------------------------------
DRACHTIO_HOST=127.0.0.1
DRACHTIO_PORT=9022
DRACHTIO_SECRET=cymru

# ---------------------------------------------------------------------------
# FreeSWITCH — RTP media server
# ---------------------------------------------------------------------------
FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=8021
FREESWITCH_SECRET=JambonzR0ck$

# ---------------------------------------------------------------------------
# Outbound call routing (voice-app → Kamailio)
# Leave as default if running everything on the same host
# ---------------------------------------------------------------------------
SIP_REGISTRAR=127.0.0.1:5060

# Caller ID shown when claude-phone places outbound calls
DEFAULT_CALLER_ID=claude-phone

# ---------------------------------------------------------------------------
# Claude API Server
# Runs natively (not in Docker) so the `claude` CLI binary is accessible.
# Start with: cd claude-api-server && node server.js
#
# No ANTHROPIC_API_KEY needed here — the server removes it so the CLI
# falls back to Claude Pro / Max subscription auth from ~/.claude
# ---------------------------------------------------------------------------
CLAUDE_API_URL=http://127.0.0.1:3333

# ---------------------------------------------------------------------------
# ElevenLabs TTS
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Default voice ID (per-device voices are set in voice-app/config/devices.json)
ELEVENLABS_VOICE_ID=your-default-voice-id

# ---------------------------------------------------------------------------
# OpenAI — Whisper STT
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------
HTTP_PORT=3000
WS_PORT=3001
AUDIO_DIR=/app/audio

# ---------------------------------------------------------------------------
# Outbound call limits
# ---------------------------------------------------------------------------
MAX_CONVERSATION_TURNS=10
OUTBOUND_RING_TIMEOUT=30

# ---------------------------------------------------------------------------
# Optional debug
# ---------------------------------------------------------------------------
# DEBUG=voice-app:*
